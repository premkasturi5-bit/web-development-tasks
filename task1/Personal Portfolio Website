<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Portfolio</title>
<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}
body{
    background:#f4f4f4;
    scroll-behavior:smooth;
}
nav{
    background:#333;
    padding:15px;
    text-align:center;
    position:sticky;
    top:0;
}
nav a{
    color:white;
    text-decoration:none;
    margin:0 10px;
    transition:0.3s;
}
nav a:hover{
    color:#00d9ff;
}
section{
    padding:50px 20px;
    text-align:center;
    animation:fadeIn 1s ease;
}
.card{
    background:white;
    padding:20px;
    margin:15px auto;
    max-width:700px;
    border-radius:10px;
    box-shadow:0 0 10px rgba(0,0,0,0.1);
    transition:0.3s;
}
.card:hover{
    transform:translateY(-5px);
}
.profile-img{
    width:150px;
    border-radius:50%;
    margin-bottom:15px;
}
.btn{
    display:inline-block;
    padding:10px 20px;
    background:#007bff;
    color:white;
    text-decoration:none;
    border-radius:5px;
    margin-top:10px;
}
.btn:hover{
    background:#0056b3;
}
footer{
    background:#333;
    color:white;
    text-align:center;
    padding:15px;
}
@keyframes fadeIn{
    from{
        opacity:0;
        transform:translateY(20px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}
@media(max-width:768px){
    nav a{
        display:block;
        margin:8px 0;
    }
}
</style>
</head>
<body>
<nav>
    <a href="#profile">Profile</a>
    <a href="#education">Education</a>
    <a href="#skills">Skills</a>
    <a href="#projects">Projects</a>
    <a href="#contact">Contact</a>
</nav>
<section id="profile">
    <img src="https://via.placeholder.com/150" class="profile-img" alt="Profile">
    <h1>Your Name</h1>
    <p>Aspiring Web Developer</p>
</section>
<section id="education">
    <div class="card">
        <h2>Education</h2>
        <p>B.Tech in Computer Science</p>
        <p>XYZ University</p>
    </div>
</section>
<section id="skills">
    <div class="card">
        <h2>Technical Skills</h2>
        <p>HTML, CSS, JavaScript, Python, Java</p>
    </div>
    <div class="card">
        <h2>Hobbies</h2>
        <p>Reading, Coding, Music, Travel</p>
    </div>
</section>
<section id="projects">
    <div class="card">
        <h2>Projects</h2>
        <p>Portfolio Website</p>
        <p>Student Management System</p>
    </div>
    <div class="card">
        <h2>Achievements</h2>
        <p>🏆 Coding Competition Winner</p>
        <p>📜 Web Development Certification</p>
    </div>
    <div class="card">
        <h2>Resume</h2>
        <a href="resume.pdf" class="btn">Download Resume</a>
    </div>
</section>
<section id="contact">
    <div class="card">
        <h2>Contact</h2>
        <p>Email: your@email.com</p>
        <p>Phone: +91 9876543210</p>
        <p>LinkedIn: linkedin.com/in/yourname</p>
    </div>
</section>
<footer>
    <p>© 2026 Your Name | Portfolio</p>
</footer>
<script>
document.querySelectorAll('nav a').forEach(link=>{
    link.addEventListener('click',function(){
        this.style.color='yellow';
        setTimeout(()=>{
            this.style.color='white';
        },500);
    });
});
</script>
</body>
</html>
